TRIPSURE_BASE_URL=
TRIPSURE_TENANT_ID=
TRIPSURE_API_KEY=

# Flight-specific TripSure credentials — a separate host AND tenant/key pair
# from the hotel ones above (per tripagent-full/backend/.env). The tenant id/
# api key fall back to the shared TRIPSURE_* credentials above when unset,
# but will 401/403 against this host until real flight-specific values are
# pasted in (hotel and flight credentials are not interchangeable).
TRIPSURE_FLIGHT_BASE_URL=https://dev-backend.tripsure.com/api
TRIPSURE_FLIGHT_TENANT_ID=
TRIPSURE_FLIGHT_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
FROM_EMAIL=
ONEVASCO_BASE_URL=https://uat.onevasco.com
ONEVASCO_CLIENT_ID=YOUR_ONEVASCO_CLIENT_ID
ONEVASCO_CLIENT_SECRET=YOUR_ONEVASCO_CLIENT_SECRET
ONEVASCO_BRANCH_CODE=YOUR_BRANCH_CODE
ONEVASCO_CLIENT_CODE=YOUR_CLIENT_CODE

# Aanya concierge — Claude + Pinecone RAG (backend/app/services/claude_client.py,
# vector_store.py; ingested via backend/scripts/embed_corpus.py). Embeddings run
# locally via sentence-transformers (BAAI/bge-base-en-v1.5) — no embedding API key.
ANTHROPIC_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=tripagent-assistant-corpus
# Optional — set after the index exists to skip a describe_index lookup on cold start.
PINECONE_INDEX_HOST=
# Only used the first time the index is created (serverless spec).
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Optional — Pexels stock-photo fallback (app/services/pexels_service.py,
# 2026-09-16, ported from tripagent-full/backend). Only used when a hotel has
# no real TripSure photo; unset means that fallback silently does nothing (no
# error). Free API key from https://www.pexels.com/api/ — license confirmed
# commercial-safe, no fee, no attribution required.
PEXELS_API_KEY=YOUR_PEXELS_API_KEY

# Demo-safety kill switch (see backend/docs/hotel-booking-signoff.md). Default
# true: request_flight_booking/request_hotel_booking show a polished DEMO
# confirmation card instead of the real advisor-handoff card, and
# search_flights falls back to clearly-labeled sample fares if TripSure's
# flight vendor is unavailable, so a live showcase never stalls or shows an
# obvious placeholder. Set to false only once real behavior should resume —
# this does NOT enable live booking on its own; see the sign-off doc.
DEMO_MODE=true

# --- Anaya V6 (app/anaya_v6/) --------------------------------------------
# Hard kill switch for the whole V6 concierge (web AND WhatsApp endpoints).
# Unset/anything but the literal string "false" = ON. Set to "false" to make
# both endpoints fail safe straight to an advisor-handoff card with no model
# or tool call — no deploy needed, just a config change + restart.
ANAYA_V6_ENABLED=true

# Real hotel booking/cancellation execution gate (app/anaya_v6/tools/booking_tools.py).
# MUST remain unset/false in every environment until Amit has explicitly signed
# off per backend/docs/hotel-booking-signoff.md (the payment gap documented
# there is not resolved). When false, Anaya only drafts and hands off to an
# advisor — it never calls TripSure's booking/cancellation endpoints.
BOOKING_LIVE_ENABLED=false

# Shared secret the scheduler (see backend/docs/ANAYA_V6_PHASE3_DEPLOYMENT_CHECKLIST.md)
# must send as the `X-Internal-Secret` header when calling
# POST /internal/anaya/tasks/tick. Unset means that endpoint refuses every
# request with 403 (fails closed, never open) — generate a real random value
# per environment and set it directly in that environment's secret store;
# never commit an actual value here.
ANAYA_INTERNAL_TICK_SECRET=

# Phase 4C — real-identity/business-data write gate (app/anaya_v6/
# identity_service.py, profile_sync_service.py, enquiry_service.py,
# conversation_service.py). Default/unset = false: Anaya behaves exactly
# as it did before Phase 4C — no lookup or write against members/
# enquiries/member_travel_preferences/conversations ever happens, and a
# customer's profile lives only in anaya_trip_state.profile, same as
# always. Set to true only once the Phase 4C migrations (150/151/152)
# have actually been applied — this is the FIRST Anaya V6 code that
# writes into the shared members/enquiries business tables rather than
# its own sandboxed anaya_* tables, so it gets its own explicit,
# default-off switch, same "build it, gate it, let a human flip it on"
# pattern as BOOKING_LIVE_ENABLED and ANAYA_INTERNAL_TICK_SECRET.
ANAYA_PROFILE_SYNC_ENABLED=false

# Shared secret required as the `X-Admin-Key` header on the access-request
# review endpoints (GET /access-requests/pending, POST
# /access-requests/{id}/approve, POST /access-requests/{id}/deny — see
# app/dependencies/admin_auth.py). This is a shared-secret gate, NOT a
# staff-login system — no per-admin identity/accountability. Unset means
# every request to those 3 endpoints is rejected with 500 (fails closed,
# never open). Generate a real random value per environment and set it
# directly in that environment's secret store; never commit an actual
# value here. TRIPAGENT-FE's admin panel sends this from its OWN backend
# (a Next.js Route Handler), never from browser-visible code — see that
# repo's own note on the same key.
ADMIN_API_KEY=

# Local-dev CORS switch (see main.py, app/config.py). Default/unset/anything
# other than the literal string "development" = strict production behavior:
# the explicit, hardcoded allow_origins list, unchanged. Setting this to
# "development" (local dev ONLY — never in a real deployment) switches CORS
# to allow_origin_regex, matching ANY http://localhost:<port> or
# http://127.0.0.1:<port> automatically — so a static dev server that picks
# a fresh random port on every restart (`npx serve .`, `python -m
# http.server`, etc.) never needs a manual CORS allow-list update again.
# Fails closed like every other toggle here: forgetting to set this in a
# real deployment keeps the strict list, never the permissive regex.
APP_ENV=

# Local-dev override for the invitation email's "Claim your invitation"
# link base (see app/config.py's site_base_url, invite_service.py's
# _INVITE_BASE_URL). Only ever read when APP_ENV=development — ignored
# entirely otherwise. Default when unset: http://localhost:5500. Set this
# if your local static server (python -m http.server / npx serve .) is
# running on a different port than 5500 when you want a real emailed link
# to work locally. Production always uses the hardcoded Vercel URL — this
# var cannot override that, by design.
SITE_LOCAL_BASE_URL=