TRIPSURE_BASE_URL=
TRIPSURE_TENANT_ID=
TRIPSURE_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
FROM_EMAIL=
ONEVASCO_BASE_URL=https://uat.onevasco.com
ONEVASCO_CLIENT_ID=YOUR_ONEVASCO_CLIENT_ID
ONEVASCO_CLIENT_SECRET=YOUR_ONEVASCO_CLIENT_SECRET
ONEVASCO_BRANCH_CODE=YOUR_BRANCH_CODE
ONEVASCO_CLIENT_CODE=YOUR_CLIENT_CODE

# Aanya concierge — Claude + Pinecone RAG (backend/app/services/claude_client.py,
# vector_store.py; ingested via backend/scripts/embed_corpus.py). Embeddings run
# locally via sentence-transformers (BAAI/bge-base-en-v1.5) — no embedding API key.
ANTHROPIC_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=tripagent-assistant-corpus
# Optional — set after the index exists to skip a describe_index lookup on cold start.
PINECONE_INDEX_HOST=
# Only used the first time the index is created (serverless spec).
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Demo-safety kill switch (see backend/docs/hotel-booking-signoff.md). Default
# true: request_flight_booking/request_hotel_booking show a polished DEMO
# confirmation card instead of the real advisor-handoff card, and
# search_flights falls back to clearly-labeled sample fares if TripSure's
# flight vendor is unavailable, so a live showcase never stalls or shows an
# obvious placeholder. Set to false only once real behavior should resume —
# this does NOT enable live booking on its own; see the sign-off doc.
DEMO_MODE=true